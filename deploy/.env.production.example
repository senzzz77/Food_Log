# A domain with an A record pointing to this server's public IPv4 address.
APP_DOMAIN=diet.example.com

MYSQL_DATABASE=diet_assistant
MYSQL_USER=diet_app
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

# Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_a_96_character_random_jwt_secret
TZ=Asia/Shanghai

# 视觉识别（拍照识别 / 文字识别 / 营养成分表识别必需）
# 使用中转服务，模型 qwen3.8-flash（支持图片输入）
DASHSCOPE_API_KEY=sk-你的中转key
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_BASE_URL=https://konapi.cloud/v1
